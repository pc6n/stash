{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash",
  "version": "3.2.0",
  "identifier": "ch.tnx.Stash",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "picker",
        "title": "Stash",
        "width": 420,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "url": "/?window=picker"
      },
      {
        "label": "settings",
        "title": "Stash Settings",
        "width": 440,
        "height": 520,
        "visible": false,
        "resizable": true,
        "url": "/?window=settings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
